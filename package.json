{
  "name": "aicc-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AICC Conversation Core — 세션·컨텍스트·의도·정책·핸드오프 공통 엔진 (설계서 §1.2/§13-7)",
  "exports": {
